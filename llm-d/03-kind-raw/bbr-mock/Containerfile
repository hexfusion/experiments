FROM registry.access.redhat.com/ubi9/go-toolset:1.25 AS build
WORKDIR /opt/app-root/src
USER 0
COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY internal/ ./internal/
COPY 03-kind-raw/bbr-mock/ ./03-kind-raw/bbr-mock/
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags='-s -w' -o /tmp/bbr-mock ./03-kind-raw/bbr-mock

FROM registry.access.redhat.com/ubi9/ubi-micro:latest
COPY --from=build /tmp/bbr-mock /usr/local/bin/bbr-mock
USER 65532:65532
EXPOSE 9001
ENTRYPOINT ["/usr/local/bin/bbr-mock"]
