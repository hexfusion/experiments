FROM registry.access.redhat.com/ubi9/go-toolset:1.25 AS build
WORKDIR /opt/app-root/src
USER 0
COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY internal/ ./internal/
COPY 01-basic/vllm-mock/ ./01-basic/vllm-mock/
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags='-s -w' -o /tmp/vllm-mock ./01-basic/vllm-mock

FROM registry.access.redhat.com/ubi9/ubi-micro:latest
COPY --from=build /tmp/vllm-mock /usr/local/bin/vllm-mock
USER 65532:65532
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/vllm-mock"]
