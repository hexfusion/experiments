FROM registry.access.redhat.com/ubi9/go-toolset:1.25 AS build
WORKDIR /opt/app-root/src
USER 0
COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY internal/ ./internal/
COPY 02-vllm-sim/epp-mock/ ./02-vllm-sim/epp-mock/
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags='-s -w' -o /tmp/epp-mock ./02-vllm-sim/epp-mock

FROM registry.access.redhat.com/ubi9/ubi-micro:latest
COPY --from=build /tmp/epp-mock /usr/local/bin/epp-mock
USER 65532:65532
EXPOSE 9002
ENTRYPOINT ["/usr/local/bin/epp-mock"]
