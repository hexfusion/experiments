+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Red Hat, Inc.
+
+//! Explicit body modes for proxies that report global rather than route modes.
+
+use serde::Deserialize;
+
+use crate::response::BodyMode;
+
+/// Effective body modes, defaulting independently to Envoy's protocol metadata.
+///
+/// Configured values must match the proxy's existing route configuration. These
+/// settings do not send a `mode_override` or change the proxy's processing mode.
+#[derive(Debug, Clone, Copy, Default, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct ProcessingMode {
+    /// Effective request body mode.
+    pub request_body_mode: ConfiguredBodyMode,
+
+    /// Effective response body mode.
+    pub response_body_mode: ConfiguredBodyMode,
+}
+
+/// Source of a direction's effective body mode.
+#[derive(Debug, Clone, Copy, Default, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ConfiguredBodyMode {
+    /// Use the mode reported by Envoy.
+    #[default]
+    Envoy,
+
+    /// No body messages are sent.
+    None,
+
+    /// Acknowledge each body chunk independently.
+    Streamed,
+
+    /// Process the complete buffered body.
+    Buffered,
+
+    /// Process full-duplex body messages using streamed body responses.
+    FullDuplexStreamed,
+}
+
+impl ConfiguredBodyMode {
+    /// Resolve an explicit mode or retain the received protocol mode.
+    pub(crate) const fn resolve(self, received: BodyMode) -> BodyMode {
+        match self {
+            Self::Envoy => received,
+            Self::None => BodyMode::None,
+            Self::Streamed => BodyMode::Streamed,
+            Self::Buffered => BodyMode::Buffered,
+            Self::FullDuplexStreamed => BodyMode::FullDuplexStreamed,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{ConfiguredBodyMode, ProcessingMode};
+    use crate::{config::ExtProcConfig, response::BodyMode};
+
+    #[test]
+    fn processing_modes_inherit_independently() -> Result<(), serde_yaml::Error> {
+        let cfg: ExtProcConfig =
+            serde_yaml::from_str("server:\n  processing_mode:\n    request_body_mode: streamed\n")?;
+
+        assert_eq!(
+            cfg.server.processing_mode.request_body_mode.resolve(BodyMode::None),
+            BodyMode::Streamed,
+            "the explicit request mode must override stale metadata"
+        );
+        assert_eq!(
+            cfg.server
+                .processing_mode
+                .response_body_mode
+                .resolve(BodyMode::Buffered),
+            BodyMode::Buffered,
+            "the response mode must continue to inherit independently"
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn processing_modes_default_to_received() -> Result<(), serde_yaml::Error> {
+        let cfg: ExtProcConfig = serde_yaml::from_str("{}")?;
+
+        for mode in [
+            BodyMode::None,
+            BodyMode::Streamed,
+            BodyMode::Buffered,
+            BodyMode::FullDuplexStreamed,
+        ] {
+            assert_eq!(cfg.server.processing_mode.request_body_mode.resolve(mode), mode);
+            assert_eq!(cfg.server.processing_mode.response_body_mode.resolve(mode), mode);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn unsupported_modes_and_unknown_fields_are_rejected() {
+        for yaml in [
+            "request_body_mode: buffered_partial",
+            "response_body_mode: guessed",
+            "request_mode: streamed",
+        ] {
+            assert!(
+                serde_yaml::from_str::<ProcessingMode>(yaml).is_err(),
+                "invalid mode must fail: {yaml}"
+            );
+        }
+    }
+
+    #[test]
+    fn explicit_modes_match_the_protocol() {
+        for (configured, expected) in [
+            (ConfiguredBodyMode::None, BodyMode::None),
+            (ConfiguredBodyMode::Streamed, BodyMode::Streamed),
+            (ConfiguredBodyMode::Buffered, BodyMode::Buffered),
+            (ConfiguredBodyMode::FullDuplexStreamed, BodyMode::FullDuplexStreamed),
+        ] {
+            assert_eq!(configured.resolve(BodyMode::None), expected);
+        }
+    }
+}
