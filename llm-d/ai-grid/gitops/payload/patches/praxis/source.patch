+#[tokio::test]
+async fn configured_streamed_modes_ack_each_chunk_with_stale_or_absent_protocol_config() {
+    use praxis_proto::envoy::service::ext_proc::v3::ProtocolConfiguration;
+
+    let yaml = format!(
+        "{HEADERS_CONFIG}\nserver:\n  processing_mode:\n    request_body_mode: streamed\n    response_body_mode: streamed\n"
+    );
+    let (mut client, _shutdown) = start_server(&yaml).await;
+
+    for protocol_config in [Some(ProtocolConfiguration::default()), None] {
+        let (tx, mut inbound) = open_stream(&mut client).await;
+        let mut headers = make_request_headers("POST", "/v1/chat/completions", false);
+        headers.protocol_config = protocol_config;
+        tx.send(headers).await.expect("request headers");
+        let response = next_full_duplex_msg(&mut inbound).await;
+        assert!(matches!(response.response, Some(RespVariant::RequestHeaders(_))));
+        assert!(response.mode_override.is_none(), "Praxis must not change Envoy's mode");
+        assert!(
+            extract_all_set_headers(std::slice::from_ref(&response))
+                .iter()
+                .any(|h| h.key.eq_ignore_ascii_case("x-test") && h.value == "extproc"),
+            "header mutations must arrive before body streaming starts"
+        );
+
+        for (body, eos) in [(b"first".as_slice(), false), (b"second".as_slice(), true)] {
+            tx.send(ProcessingRequest {
+                request: Some(ReqVariant::RequestBody(HttpBody {
+                    body: body.to_vec(),
+                    end_of_stream: eos,
+                })),
+                ..Default::default()
+            })
+            .await
+            .expect("request body chunk");
+            let response = next_full_duplex_msg(&mut inbound).await;
+            let Some(RespVariant::RequestBody(reply)) = response.response else {
+                panic!("each request chunk must be acknowledged before the next is sent");
+            };
+            assert!(
+                matches!(reply.response.expect("continue response").body_mutation.and_then(|m| m.mutation),
+                    Some(praxis_proto::envoy::service::ext_proc::v3::body_mutation::Mutation::Body(bytes)) if bytes == body),
+                "request bytes must pass unchanged"
+            );
+            assert!(response.mode_override.is_none());
+        }
+
+        tx.send(make_response_headers(200, false))
+            .await
+            .expect("response headers");
+        let response = next_full_duplex_msg(&mut inbound).await;
+        assert!(matches!(response.response, Some(RespVariant::ResponseHeaders(_))));
+        assert!(response.mode_override.is_none());
+
+        for (body, eos) in [
+            (b"data: {\"cho".as_slice(), false),
+            (b"ices\":[]}\n\ndata: [DONE]\n\n".as_slice(), true),
+        ] {
+            tx.send(make_response_body(body, eos))
+                .await
+                .expect("response body chunk");
+            let response = next_full_duplex_msg(&mut inbound).await;
+            let Some(RespVariant::ResponseBody(reply)) = response.response else {
+                panic!("each SSE fragment must be acknowledged before the next is sent");
+            };
+            assert!(
+                matches!(reply.response.expect("continue response").body_mutation.and_then(|m| m.mutation),
+                    Some(praxis_proto::envoy::service::ext_proc::v3::body_mutation::Mutation::Body(bytes)) if bytes == body),
+                "SSE bytes must pass unchanged"
+            );
+            assert!(response.mode_override.is_none());
+        }
+        drop(tx);
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_secs(2), inbound.message())
+                .await
+                .expect("stream must finish")
+                .expect("stream must succeed")
+                .is_none()
+        );
+    }
+}
