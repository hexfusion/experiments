+helm.sh/hook-weight: {{ . | quote }}
+helm.sh/hook-delete-policy: before-hook-creation
+{{- end -}}
diff --git a/charts/grid-operator/templates/bootstrap-job.yaml b/charts/grid-operator/templates/bootstrap-job.yaml
new file mode 100644
index 0000000..10f33fd
--- /dev/null
+++ b/charts/grid-operator/templates/bootstrap-job.yaml
@@ -0,0 +1,93 @@
+{{- include "grid-operator.normalize" . }}
+{{- include "grid-operator.validateGrid" . }}
+{{- include "grid-operator.enrollment.validate" . }}
+{{- if include "grid-operator.bootstrap.enabled" . }}
+{{- $e := include "grid-operator.enrollment.settings" . | fromYaml }}
+{{- if and $e.enabled (ne $e.siteName .Values.swim.siteName) }}
+{{- fail "bootstrap requires enrollment.siteName to match swim.siteName" }}
+{{- end }}
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: {{ include "grid-operator.bootstrap.name" . }}
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "grid-operator.labels" . | nindent 4 }}
+  annotations:
+    {{- include "grid-operator.bootstrap.hooks" "-4" | nindent 4 }}
+spec:
+  activeDeadlineSeconds: {{ .Values.bootstrap.activeDeadlineSeconds }}
+  ttlSecondsAfterFinished: {{ .Values.bootstrap.ttlSecondsAfterFinished }}
+  backoffLimit: 0
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/instance: {{ .Release.Name }}
+        app.kubernetes.io/component: site-bootstrap
+    spec:
+      serviceAccountName: {{ include "grid-operator.bootstrap.name" . }}
+      automountServiceAccountToken: true
+      enableServiceLinks: false
+      restartPolicy: Never
+      {{- with .Values.imagePullSecrets }}
+      imagePullSecrets:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      securityContext:
+        runAsNonRoot: true
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: bootstrap
+          image: {{ include "grid-operator.image" . | quote }}
+          imagePullPolicy: {{ .Values.image.pullPolicy | quote }}
+          command: [operator, bootstrap]
+          args:
+            - --network
+            - {{ .Values.grid.network | quote }}
+            - --grid-id
+            - {{ .Values.grid.id | quote }}
+            - --peer-trust
+            - {{ .Values.grid.peerTrust | default "pin" | quote }}
+            - --enroll-site-name
+            - {{ .Values.swim.siteName | quote }}
+            - --enroll-identity-secret
+            - {{ $e.identitySecretName | quote }}
+            - --enroll-ca-secret
+            - {{ $e.caSecretName | quote }}
+            {{- with .Values.grid.swimKeySecretName }}
+            - --swim-key-secret
+            - {{ . | quote }}
+            {{- end }}
+          env:
+            - name: RUST_LOG
+              value: {{ include "grid-operator.rustLog" . | quote }}
+            {{- with include "grid-operator.enrollment.env" . | trim }}
+            {{- . | nindent 12 }}
+            {{- end }}
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities:
+              drop: [ALL]
+          {{- with include "grid-operator.enrollment.volumeMounts" . | trim }}
+          volumeMounts:
+            {{- . | nindent 12 }}
+          {{- end }}
+          {{- with .Values.resources }}
+          resources:
+            {{- toYaml . | nindent 12 }}
+          {{- end }}
+      {{- with include "grid-operator.enrollment.volumes" . | trim }}
+      volumes:
+        {{- . | nindent 8 }}
+      {{- end }}
+      {{- with .Values.nodeSelector }}
+      nodeSelector:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+      {{- with .Values.tolerations }}
+      tolerations:
+        {{- toYaml . | nindent 8 }}
+      {{- end }}
+{{- end }}
diff --git a/charts/grid-operator/templates/bootstrap-rbac.yaml b/charts/grid-operator/templates/bootstrap-rbac.yaml
new file mode 100644
index 0000000..02b80e1
--- /dev/null
+++ b/charts/grid-operator/templates/bootstrap-rbac.yaml
@@ -0,0 +1,82 @@
+{{- include "grid-operator.normalize" . }}
+{{- if include "grid-operator.bootstrap.enabled" . }}
+{{- $name := include "grid-operator.bootstrap.name" . }}
+{{- $e := include "grid-operator.enrollment.settings" . | fromYaml }}
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: {{ $name }}
+  namespace: {{ .Release.Namespace }}
+  labels:
+    {{- include "grid-operator.labels" . | nindent 4 }}
+  annotations:
+    {{- include "grid-operator.bootstrap.hooks" "-6" | nindent 4 }}
+{{- if .Values.rbac.create }}
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: {{ $name }}
+  namespace: {{ .Release.Namespace }}
+  annotations:
+    {{- include "grid-operator.bootstrap.hooks" "-6" | nindent 4 }}
+rules:
+  - apiGroups: [""]
+    resources: [secrets]
+    resourceNames:
+      {{- $names := list $e.identitySecretName $e.caSecretName .Values.grid.swimKeySecretName }}
+      {{- if $e.enabled }}
+      {{- $names = append $names $e.tokenSecretRef.name }}
+      {{- end }}
+      {{- toYaml ($names | compact | uniq) | nindent 6 }}
+    verbs: [get]
+  {{- if $e.enabled }}
+  - apiGroups: [""]
+    resources: [secrets]
+    verbs: [create]
+  {{- end }}
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: {{ $name }}
+  namespace: {{ .Release.Namespace }}
+  annotations:
+    {{- include "grid-operator.bootstrap.hooks" "-6" | nindent 4 }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: Role
+  name: {{ $name }}
+subjects:
+  - kind: ServiceAccount
+    name: {{ $name }}
+    namespace: {{ .Release.Namespace }}
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRole
+metadata:
+  name: {{ $name }}
+  annotations:
+    {{- include "grid-operator.bootstrap.hooks" "-6" | nindent 4 }}
+rules:
+  - apiGroups: [grid.praxis.fast]
+    resources: [gridnetworks]
+    resourceNames: [{{ .Values.grid.network | quote }}]
+    verbs: [list]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRoleBinding
+metadata:
+  name: {{ $name }}
+  annotations:
+    {{- include "grid-operator.bootstrap.hooks" "-6" | nindent 4 }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: ClusterRole
+  name: {{ $name }}
+subjects:
+  - kind: ServiceAccount
+    name: {{ $name }}
+    namespace: {{ .Release.Namespace }}
+{{- end }}
+{{- end }}
diff --git a/crates/operator/src/enroll/bootstrap.rs b/crates/operator/src/enroll/bootstrap.rs
new file mode 100644
index 0000000..a0af4f9
--- /dev/null
+++ b/crates/operator/src/enroll/bootstrap.rs
@@ -0,0 +1,194 @@
+//! Create missing site identity Secrets before Helm installs a `GridNetwork`.
+
+use clap::Parser as _;
+use k8s_openapi::api::core::v1::Secret;
+use kube::{Api, Client, api::ListParams};
+use zeroize::Zeroizing;
+
+use super::{Config, EnrollError, KubeStore, Settings, Store, Target, enroll, read_pem, required};
+use crate::crd::grid_network::{GridNetwork, PeerTrustMode, SecretRef};
+
+/// Inputs shared by the bootstrap hook and its network template.
+#[derive(clap::Parser, Debug)]
+#[command(name = "operator bootstrap", about = "Initialize site certificates without replacing existing Secrets")]
+pub struct Args {
+    /// Existing enrollment configuration and destination Secret names.
+    #[command(flatten)]
+    pub enrollment: Config,
+    /// Expected grid identifier.
+    #[arg(long)]
+    pub grid_id: String,
+    /// Intended cluster-scoped network name.
+    #[arg(long)]
+    pub network: String,
+    /// Peer trust required by the network.
+    #[arg(long, value_enum, default_value = "pin")]
+    pub peer_trust: PeerTrustMode,
+    /// Existing Secret holding the shared 32-byte SWIM key.
+    #[arg(long)]
+    pub swim_key_secret: Option<String>,
+}
+
+/// Run the one-shot command and report failures to the Job controller.
+pub async fn command() -> std::process::ExitCode {
+    let args = Args::parse_from(std::env::args_os().skip(1));
+    let result = match Client::try_default().await {
+        Ok(client) => Box::pin(run(&client, &args)).await,
+        Err(error) => Err(EnrollError::Kube(error.to_string())),
+    };
+    match result {
+        Ok(()) => std::process::ExitCode::SUCCESS,
+        Err(error) => {
+            tracing::error!(%error, "site bootstrap failed; existing certificate Secrets were preserved");
+            std::process::ExitCode::FAILURE
+        },
+    }
+}
+
+/// Validate existing material or enroll a new site before network creation.
+///
+/// # Errors
+///
+/// Refuses API failures, incompatible network references, invalid existing
+/// material, and initial issuance when the network already exists.
+pub async fn run(client: &Client, args: &Args) -> Result<(), EnrollError> {
+    let site = required(args.enrollment.site_name.as_deref(), "site name")?;
+    certs::validate_site_name(&site).map_err(|error| EnrollError::Config(error.to_string()))?;
+    let _grid = required(Some(&args.grid_id), "grid ID")?;
+    let _network = required(Some(&args.network), "network name")?;
+    let target = Target {
+        site_secret: required(Some(&args.enrollment.identity_secret), "identity Secret")?,
+        ca_secret: required(Some(&args.enrollment.ca_secret), "CA Secret")?,
+    };
+    let namespace = client.default_namespace();
+    let networks: Api<GridNetwork> = Api::all(client.clone());
+    // Listing distinguishes an absent object from an unavailable CRD endpoint.
+    let listed = networks
+        .list(&ListParams::default().fields(&format!("metadata.name={}", args.network)))
+        .await
+        .map_err(|error| EnrollError::Kube(format!("reading GridNetwork {}: {error}", args.network)))?;
+    let is_bootstrap = match listed.items.as_slice() {
+        [] => true,
+        [network] => {
+            validate_network(network, args, namespace, &target)?;
+            false
+        },
+        _multiple => return Err(EnrollError::Config("expected one GridNetwork".to_owned())),
+    };
+    tracing::info!(is_bootstrap, network = %args.network, "detected site bootstrap state");
+    let store = KubeStore(Api::namespaced(client.clone(), namespace));
+    check_swim_key(&store, args.swim_key_secret.as_deref()).await?;
+    let anchor = args
+        .enrollment
+        .grid_ca_file
+        .as_deref()
+        .or(args.enrollment.ca_file.as_deref())
+        .map(read_pem)
+        .transpose()?;
+    if existing_identity(&store, &target, &site, args.peer_trust, anchor.as_deref()).await? {
+        tracing::info!(secret = %target.site_secret, "reusing validated site certificates without writes");
+        return Ok(());
+    }
+    if !is_bootstrap || !args.enrollment.enabled {
+        return Err(EnrollError::Config(
+            "site identity is missing; enrollment requires a new network and enabled enrollment".to_owned(),
+        ));
+    }
+    let settings = Settings::from_config(&args.enrollment)?;
+    let _outcome = Box::pin(enroll(&store, &settings, &target)).await?;
+    if !existing_identity(&store, &target, &site, args.peer_trust, Some(&settings.anchor_pem)).await? {
+        return Err(EnrollError::Config("site identity disappeared during bootstrap".to_owned()));
+    }
+    tracing::info!(secret = %target.site_secret, "site certificate prerequisites satisfied");
+    Ok(())
+}
+
+/// Refuse a different network or destinations before reading any private keys.
+fn validate_network(network: &GridNetwork, args: &Args, namespace: &str, target: &Target) -> Result<(), EnrollError> {
+    let tls = &network.spec.tls;
+    let matches = |reference: Option<&SecretRef>, name: &str| {
+        reference.is_some_and(|reference| reference.name == name && reference.namespace == namespace && reference.key.is_none())
+    };
+    let swim_matches = match (tls.swim_key_ref.as_ref(), args.swim_key_secret.as_deref()) {
+        (None, None) => true,
+        (reference, Some(name)) => matches(reference, name),
+        (Some(_reference), None) => false,
+    };
+    if network.spec.grid_id != args.grid_id
+        || !matches(tls.site_secret_ref.as_ref(), &target.site_secret)
+        || !matches(tls.ca_secret_ref.as_ref(), &target.ca_secret)
+        || !swim_matches
+    {
+        return Err(EnrollError::Config(format!(
+            "GridNetwork {} does not match the configured grid and Secret references; repair its configuration explicitly",
+            args.network
+        )));
+    }
+    Ok(())
+}
+
+/// Check the shared gossip credential without generating or changing it.
+async fn check_swim_key<S: Store + Sync>(store: &S, name: Option<&str>) -> Result<(), EnrollError> {
+    let Some(name) = name else { return Ok(()); };
+    let secret = store.get(name).await?.ok_or_else(|| EnrollError::Config(format!("SWIM Secret {name} is missing")))?;
+    if !secret.data.as_ref().and_then(|data| data.get("key")).is_some_and(|key| key.0.len() == 32) {
+        return Err(EnrollError::Config(format!("SWIM Secret {name} must contain a 32-byte key")));
+    }
+    Ok(())
+}
+
+/// Check every existing Secret before allowing enrollment to spend an invite.
+async fn existing_identity<S: Store + Sync>(
+    store: &S,
+    target: &Target,
+    site: &str,
+    trust: PeerTrustMode,
+    anchors: Option<&str>,
+) -> Result<bool, EnrollError> {
+    let authorities = match store.get(&target.ca_secret).await? {
+        Some(mut secret) => {
+            let bundle = field(&mut secret, "ca.crt")?;
+            valid_authorities(&bundle, anchors.unwrap_or(&bundle))?
+        },
+        None => Vec::new(),
+    };
+    let Some(mut secret) = store.get(&target.site_secret).await? else { return Ok(false); };
+    let certificate = field(&mut secret, "tls.crt")?;
+    let key = field(&mut secret, "tls.key")?;
+    if !authorities.iter().any(|ca| certs::verify_site_cert(ca, &certificate, site).is_ok())
+        || !certs::key_matches_cert(&key, &certificate)
+        || (trust == PeerTrustMode::Spiffe && !certs::has_svid_profile(&certificate).unwrap_or(false))
+    {
+        return Err(EnrollError::Config(format!(
+            "Secret {} has an invalid site certificate, key, or trust chain; preserved for explicit repair",
+            target.site_secret
+        )));
+    }
+    Ok(true)
+}
+
+/// Currently valid, self-signed Grid CAs from a pinned bundle.
+fn valid_authorities(bundle: &str, anchors: &str) -> Result<Vec<String>, EnrollError> {
+    let invalid = |error| EnrollError::Config(format!("existing CA Secret is invalid: {error}"));
+    if bundle.len() > certs::MAX_CERT_PEM_BYTES {
+        return Err(invalid("bundle exceeds the certificate size limit".to_owned()));
+    }
+    let blocks = pem::parse_many(bundle).map_err(|error| invalid(error.to_string()))?;
+    if blocks.is_empty() || blocks.iter().any(|block| block.tag() != "CERTIFICATE") {
+        return Err(invalid("expected CA certificates".to_owned()));
+    }
+    blocks.into_iter().map(|block| {
+        certs::anchored_ca(&pem::encode(&block), anchors).map_err(|error| invalid(error.to_string()))
+    }).collect()
+}
+
+/// Remove a PEM field from a Secret, keeping key bytes out of error messages.
+fn field(secret: &mut Secret, key: &str) -> Result<Zeroizing<String>, EnrollError> {
+    let name = secret.metadata.name.as_deref().unwrap_or_default();
+    let bytes = secret.data.as_mut().and_then(|data| data.remove(key))
+        .map(|bytes| Zeroizing::new(bytes.0))
+        .ok_or_else(|| EnrollError::Config(format!("Secret {name} is missing {key}; preserved for explicit repair")))?;
+    std::str::from_utf8(&bytes).map(|value| Zeroizing::new(value.to_owned()))
+        .map_err(|_error| EnrollError::Config(format!("Secret {name} has invalid {key}; preserved for explicit repair")))
+}
+
