+{{- define "grid-operator.bootstrap.enabled" -}}
+{{- if and .Values.grid.id .Values.bootstrap.enabled -}}true{{- end -}}
+{{- end -}}
+
+{{- define "grid-operator.bootstrap.name" -}}
+{{- printf "%s-site-bootstrap" (include "grid-operator.fullname" . | trunc 48 | trimSuffix "-") -}}
+{{- end -}}
+
+{{- define "grid-operator.bootstrap.hooks" -}}
