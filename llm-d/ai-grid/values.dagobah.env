# Cluster-specific values. Every {token} in the manifests resolves from here.
# Copy to values.<env>.env for another cluster. Nothing else is env-specific.
domain=dagobah.hexfusion.local
gpu_product=NVIDIA-RTX-A5000
site_a_node=worker2
site_b_node=endor
# Both sites pull from HuggingFace so the stack is single-shot reproducible
# (no pre-staged model-store PVC). First deploy downloads ~15GB per site (~9 min).
site_a_model=hf://cpatonn/Qwen3-Coder-30B-A3B-Instruct-AWQ-4bit
site_b_model=hf://cpatonn/Qwen3-Coder-30B-A3B-Instruct-AWQ-4bit
