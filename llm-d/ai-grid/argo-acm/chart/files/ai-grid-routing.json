          "expr": "sum by (cluster) (rate(grid_route_decisions_total{cluster=~\"$cluster\",reason=~\"not_ready|no_route|bad_request\"}[5m]))",
          "legendFormat": "{{cluster}} refused",
          "refId": "B",
          "range": true
        }
      ]
    },
