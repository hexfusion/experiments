{
  "uid": "grid-front-door",
  "title": "Front door",
  "description": "What the front door lets in, turns away, and holds to its limits.",
  "tags": [
    "acme grid"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Front door, requests per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_allowed:rate * 60",
          "legendFormat": "Allowed",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_rejected:rate * 60",
          "legendFormat": "Other 4xx",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_limited:rate * 60",
          "legendFormat": "Over the limit",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_failed:rate * 60",
          "legendFormat": "Failed",
          "refId": "D",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "noValue": "no traffic",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests succeeding",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:success:ratio",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "\u2013",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "\u2013",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "description": "Share of front-door requests that succeeded in the last half minute. A dash means no requests."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Allowed, last minute",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_allowed:rate * 60",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Other 4xx, last minute",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_rejected:rate * 60",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 8
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Over the limit, last minute",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_limited:rate * 60",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 8
      }
    }
  ],
  "templating": {
    "list": []
  }
}
