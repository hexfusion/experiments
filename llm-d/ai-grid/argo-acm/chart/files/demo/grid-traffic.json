{
 "uid": "grid-traffic",
 "title": "Grid traffic and load",
 "tags": [
  "grid"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "panels": [
  {
   "type": "canvas",
   "title": "",
   "datasource": {
    "type": "prometheus",
    "uid": "grid-thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 15
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "expr": "sum(rate(grid_route_decisions_total{reason=\"routed\"}[1m])) or vector(0)",
     "legendFormat": "rps total",
     "refId": "A",
     "instant": true,
     "range": false,
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "expr": "sum(rate(grid_route_decisions_total{reason!=\"routed\"}[1m])) or vector(0)",
     "legendFormat": "refused total",
     "refId": "B",
     "instant": true,
     "range": false,
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "C",
     "legendFormat": "share Seattle east",
     "expr": "(sum(rate(grid_route_decisions_total{reason=\"routed\",backend=\"hq-east\"}[1m])) or vector(0)) / clamp_min(sum(rate(grid_route_decisions_total{reason=\"routed\"}[1m])), 1e-9)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "D",
     "legendFormat": "rps Seattle east",
     "expr": "sum(rate(grid_route_decisions_total{reason=\"routed\",backend=\"hq-east\"}[1m])) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "E",
     "legendFormat": "inflight Seattle east",
     "expr": "sum(grid_provider_in_flight_requests{grid_provider=\"hq-east\"}) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "F",
     "legendFormat": "share Seattle west",
     "expr": "(sum(rate(grid_route_decisions_total{reason=\"routed\",backend=\"hq-west\"}[1m])) or vector(0)) / clamp_min(sum(rate(grid_route_decisions_total{reason=\"routed\"}[1m])), 1e-9)"
    },
    {
     "datasource": {
      "type": "prometheus",
