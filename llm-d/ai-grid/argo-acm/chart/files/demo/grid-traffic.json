       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "description": "Share is each endpoint's part of routed requests over the last minute. In flight is the number of requests the endpoint's EPP reports running or queued. All inputs are relayed from each site's EPP by its operator; the gateway counts nothing of its own."
  },
  {
   "type": "timeseries",
   "title": "Share of routed requests",
   "datasource": {
    "type": "prometheus",
    "uid": "grid-thanos"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "expr": "sum by (backend) (rate(grid_route_decisions_total{reason=\"routed\"}[1m]))",
     "legendFormat": "{{backend}}",
     "refId": "A",
     "instant": false,
     "range": true,
     "editorMode": "code"
