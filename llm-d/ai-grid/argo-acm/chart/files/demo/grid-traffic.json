{
 "uid": "grid-traffic",
 "title": "Grid traffic and load",
 "tags": [
  "grid"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "panels": [
  {
   "type": "text",
   "title": "",
   "gridPos": {
    "h": 2,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "**Traffic and load across the grid.** Requests enter at the front door (__FRONT_DOOR_LABEL__), the hub gateway picks a site by measured availability, and each site's operator relays what its EPP sees. Arrow width is the site's share of routed traffic over the last minute; the count is requests in flight at that site right now. Seattle serves from two backends, east and west."
   }
  },
  {
   "type": "canvas",
   "title": "Where traffic goes, and how loaded each site is",
   "datasource": {
    "type": "prometheus",
    "uid": "grid-thanos"
   },
   "gridPos": {
    "h": 16,
    "w": 24,
    "x": 0,
    "y": 2
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "expr": "sum(rate(grid_route_decisions_total{reason=\"routed\"}[1m])) or vector(0)",
     "legendFormat": "rps total",
     "refId": "A",
     "instant": true,
     "range": false,
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "expr": "sum(rate(grid_route_decisions_total{reason!=\"routed\"}[1m])) or vector(0)",
     "legendFormat": "refused total",
     "refId": "B",
     "instant": true,
     "range": false,
     "editorMode": "code"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "C",
     "legendFormat": "share Seattle",
     "expr": "(sum(rate(grid_route_decisions_total{reason=\"routed\",site=\"hq\"}[1m])) or vector(0)) / clamp_min(sum(rate(grid_route_decisions_total{reason=\"routed\"}[1m])), 1e-9)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "D",
     "legendFormat": "rps Seattle",
     "expr": "sum(rate(grid_route_decisions_total{reason=\"routed\",site=\"hq\"}[1m])) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "F",
     "legendFormat": "inflight Seattle",
     "expr": "sum(grid_provider_in_flight_requests{grid_site=\"hq\"}) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "H",
     "legendFormat": "share Portland",
     "expr": "(sum(rate(grid_route_decisions_total{reason=\"routed\",site=\"factory\"}[1m])) or vector(0)) / clamp_min(sum(rate(grid_route_decisions_total{reason=\"routed\"}[1m])), 1e-9)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "I",
     "legendFormat": "rps Portland",
     "expr": "sum(rate(grid_route_decisions_total{reason=\"routed\",site=\"factory\"}[1m])) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "K",
     "legendFormat": "inflight Portland",
     "expr": "sum(grid_provider_in_flight_requests{grid_site=\"factory\"}) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "M",
     "legendFormat": "share San Jose",
     "expr": "(sum(rate(grid_route_decisions_total{reason=\"routed\",site=\"retail\"}[1m])) or vector(0)) / clamp_min(sum(rate(grid_route_decisions_total{reason=\"routed\"}[1m])), 1e-9)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "N",
     "legendFormat": "rps San Jose",
     "expr": "sum(rate(grid_route_decisions_total{reason=\"routed\",site=\"retail\"}[1m])) or vector(0)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "instant": true,
     "range": false,
     "editorMode": "code",
     "refId": "P",
     "legendFormat": "inflight San Jose",
     "expr": "sum(grid_provider_in_flight_requests{grid_site=\"retail\"}) or vector(0)"
    }
