   "description": "Arrow width is each site's share of routed requests over the last minute; arrow and box color is its saturation (rho, in-flight over the learned ceiling): green has room, amber is near the ceiling, red is at it. Gray means unmeasured. Seattle's two backends are summed (in flight, ceiling) or taken at their worst (rho). All inputs are relayed from each site's EPP by its operator; the gateway counts nothing of its own."
  },
  {
   "type": "timeseries",
   "title": "Share of routed requests per backend",
   "datasource": {
    "type": "prometheus",
    "uid": "grid-thanos"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 18
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "grid-thanos"
     },
     "expr": "sum by (backend) (rate(grid_route_decisions_total{reason=\"routed\"}[1m]))",
     "legendFormat": "{{backend}}",
     "refId": "A",
     "instant": false,
     "range": true,
     "editorMode": "code"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "right",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 55,
      "showPoints": "never",
      "stacking": {
       "mode": "percent",
       "group": "A"
      },
      "gradientMode": "opacity"
     },
     "color": {
      "mode": "palette-classic"
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "renameByRegex",
     "options": {
      "regex": "(.*)hq-east(.*)",
