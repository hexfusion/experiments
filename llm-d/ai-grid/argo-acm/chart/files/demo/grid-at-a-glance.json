{
  "uid": "grid-at-a-glance",
  "title": "Acme grid at a glance",
  "description": "Which sites are serving, where requests go, and whether they succeed.",
  "tags": [
    "acme grid"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "annotations": {
    "list": [
      {
        "name": "Site in or out of rotation",
        "datasource": {
          "type": "loki",
          "uid": "grid-loki"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "{kubernetes_namespace_name=\"grid\", kubernetes_container_name=\"praxis\"} |~ \"peer gateways held down changed|no healthy endpoint changed|no signals scrape in two polls changed\""
      },
      {
        "name": "Certificate rotated",
        "datasource": {
          "type": "loki",
          "uid": "grid-loki"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{kubernetes_namespace_name=\"grid\", kubernetes_container_name=\"operator\"} |= \"site identity rotated\""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Sites",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "hq",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_serving{site=\"hq\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Serving",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Out of rotation",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "description": "Serving: at least one of this site's backends holds a routing score at the front door, which polls it every few seconds. Out of rotation: every backend is excluded or demoted (its score is NaN)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "factory",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_serving{site=\"factory\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Serving",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Out of rotation",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "description": "Serving: at least one of this site's backends holds a routing score at the front door, which polls it every few seconds. Out of rotation: every backend is excluded or demoted (its score is NaN)."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "retail",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_serving{site=\"retail\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Serving",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Out of rotation",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "description": "Serving: at least one of this site's backends holds a routing score at the front door, which polls it every few seconds. Out of rotation: every backend is excluded or demoted (its score is NaN)."
    },
    {
      "id": 5,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per second by site",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:requests_by_site:rate",
          "legendFormat": "{{site}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "no traffic",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 7
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Requests succeeding",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:success:ratio",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 14,
        "y": 7
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Share of requests by site",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_share:ratio",
          "legendFormat": "{{site}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "no traffic"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "description": "Each site's share of the last half minute's requests."
    },
    {
      "id": 9,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Front door, requests per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_allowed:rate * 60",
          "legendFormat": "Allowed",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_rejected:rate * 60",
          "legendFormat": "Other 4xx",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_limited:rate * 60",
          "legendFormat": "Over the limit",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:front_door_failed:rate * 60",
          "legendFormat": "Failed",
          "refId": "D",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "noValue": "no traffic",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Waiting requests per site",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_queue",
          "legendFormat": "{{site}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "noValue": "no traffic",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 10,
        "y": 24
      },
      "description": "The queue depth the front door last read from each site."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Shortest certificate validity",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "min(grid:identity_valid:seconds)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "green",
                "value": 604800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 24
      }
    }
  ],
  "templating": {
    "list": []
  }
}
