{
  "uid": "grid-at-a-glance",
  "title": "Acme grid at a glance",
  "description": "Which sites are serving, where requests go, and whether they succeed.",
  "tags": [
    "acme grid"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "annotations": {
    "list": [
      {
        "name": "Certificate rotated",
        "datasource": {
          "type": "loki",
          "uid": "grid-loki"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{kubernetes_namespace_name=\"grid\", kubernetes_container_name=\"operator\"} |= \"site identity rotated\""
      }
    ]
  },
  "panels": [
    {
      "id": 20,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Front door: __FRONT_DOOR_LABEL__"
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Sites",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "hq",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_reachable{site=\"hq\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Reachable",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Unreachable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "description": "hq: its operator is up and polling. hq does not poll itself."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "factory",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_reachable{site=\"factory\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Reachable",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Unreachable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "description": "Reachable: hq's operator's last signals poll of this site succeeded. Unreachable: it failed. hq polls each site every few seconds."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "retail",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_reachable{site=\"retail\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Reachable",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Unreachable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "description": "Reachable: hq's operator's last signals poll of this site succeeded. Unreachable: it failed. hq polls each site every few seconds."
    },
    {
      "id": 11,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Seconds since the last good poll",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "grid:site_last_poll_age:seconds",
          "legendFormat": "{{site}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "description": "How stale hq's view of each site is. It climbs steadily once a site stops answering."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Shortest certificate validity",
      "datasource": {
        "type": "prometheus",
        "uid": "grid-thanos"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grid-thanos"
          },
          "expr": "min(grid:identity_valid:seconds)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "green",
                "value": 604800
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      }
    }
  ],
  "templating": {
    "list": []
  }
}
