# Render the whole grid from grid.yaml, in two stages:
#   1. the grid-gitops chart (chart/) writes the Argo CD apps, the ACM objects, the root app,
#      and each site's product-chart values;
#   2. the product chart renders each site and the hub's enrollment from those values.
# Everything both stages write is generated: change grid.yaml and run `make render`.
#
#   make render                     # product chart from grid.yaml's artifact
#   make render CHART=./chart.tgz   # from a local package, before it is pushed
#   make check                      # fail if the committed output differs from a render

HELM ?= helm
YQ ?= yq
OUT ?= .
GRID := grid.yaml
CHART ?= $(shell $(YQ) -r '.artifact.chart' $(GRID))
VERSION ?= $(shell $(YQ) -r '.artifact.version' $(GRID))
SITES = $(shell $(YQ) -r '.sites | keys | .[]' $(GRID))
# Stage 1 output, relative to OUT.
GENERATED := apps values sites hub observability setup/root-app.yaml
# A local chart has no version to select.
CHART_ARGS = $(CHART) $(if $(findstring oci://,$(CHART)),--version $(VERSION),) --skip-tests
# --api-versions for each API a target file lists, so capability checks render as on the cluster.
API_ARGS = $$($(YQ) -r '(.apiVersions // [])[] | "--api-versions " + .' $(1))
# Split the chart's stream into files at each `# file: <path>` marker.
SPLIT = awk -v out=$(OUT) ' \
	/^---$$/ || /^\# Source: / { next } \
	/^\# file: / { f = out "/" $$3; \
		if (!(f in seen)) { seen[f] = 1; d = f; sub(/\/[^\/]*$$/, "", d); system("mkdir -p " d); \
			print "\# Generated by make render from grid.yaml. Do not edit." > f } \
		else { print "---" > f } next } \
	{ print > f }'

.PHONY: render render-gitops render-sites check

render: render-gitops render-sites

render-gitops:
	@set -e; mkdir -p $(OUT)/setup; cd $(OUT) && rm -rf $(GENERATED)
	@$(HELM) template grid-gitops chart -f $(GRID) | $(SPLIT)
	@echo "rendered grid-gitops"

render-sites:
	@set -e; for site in $(SITES); do \
		dir=$(OUT)/sites/$$site/manifests; rm -rf $$dir; mkdir -p $$dir; \
		$(HELM) template grid-$$site $(CHART_ARGS) $(call API_ARGS,$(OUT)/sites/$$site/site.yaml) --namespace grid \
			-f $(OUT)/values/common.yaml -f $(OUT)/sites/$$site/values.yaml --output-dir $$dir >/dev/null; \
		echo "rendered sites/$$site"; \
	done
	@set -e; dir=$(OUT)/hub/enrollment/manifests; rm -rf $$dir; mkdir -p $$dir; \
		$(HELM) template grid-enrollment $(CHART_ARGS) $(call API_ARGS,$(OUT)/hub/enrollment/target.yaml) --namespace grid-enrollment \
			-f $(OUT)/hub/enrollment/values.yaml --output-dir $$dir >/dev/null; \
		echo "rendered hub/enrollment"

check:
	@set -e; tmp=$$(mktemp -d); trap 'rm -rf $$tmp' EXIT; \
		$(MAKE) --no-print-directory render OUT=$$tmp >/dev/null; \
		status=0; \
		for path in $(GENERATED); do \
			diff -r $$path $$tmp/$$path || status=1; \
		done; \
		if [ $$status -ne 0 ]; then echo "generated output differs from the render: run make render"; fi; \
		exit $$status
